{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neurodesk domains",
  "description": "apps.json domains.json: source repositories and optional container launch fields share each domain object. Source of truth: this file and src/main/config/containerCatalogSchema.ts; change both together. The apps.json catalog CI fetches this schema for deployment validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domains"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9])){0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/domain"
      }
    }
  },
  "definitions": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repositories"],
      "properties": {
        "source_repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          }
        },
        "title": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()-]{0,63}$"
        },
        "description": {
          "type": "string",
          "pattern": "^[^<>&]{1,2000}$"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?::[0-9]{1,5})?(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
        },
        "defaultVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "containerName": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "volumeMount": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "defaultStorageMount": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "releaseHistoryUrl": {
          "type": "string",
          "pattern": "^https://[^\\s\"'<>`\\/]+(?:/[^\\s\"'<>`\\\\]*)?$"
        },
        "remoteUrl": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s\"'<>`\\/]+(?:/[^\\s\"'<>`\\\\]*)?$"
          }
        },
        "downloadUrls": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s\"'<>`\\\\]+$"
          }
        },
        "appJsonUrl": {
          "type": "string",
          "pattern": "^https://[^\\s\"'<>`\\/]+(?:/[^\\s\"'<>`\\\\]*)?$"
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,39}$"
          }
        },
        "minAppVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      },
      "if": {
        "minProperties": 2
      },
      "then": {
        "properties": {
          "title": {},
          "description": {},
          "registry": {},
          "defaultVersion": {},
          "containerName": {},
          "volumeMount": {},
          "defaultStorageMount": {}
        },
        "required": [
          "title",
          "description",
          "registry",
          "defaultVersion",
          "containerName",
          "volumeMount",
          "defaultStorageMount"
        ]
      },
      "description": "A domain may omit launch fields. If it has any, all required launch fields must be present."
    }
  }
}
